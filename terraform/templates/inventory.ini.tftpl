%{ for name, node in nodes ~}
${name} ansible_host=${node.ip} ansible_user=${user} ansible_ssh_private_key_file=${key_path}
%{ endfor ~}

[k8s_control]
k8s-control

[k8s_workers]
k8s-worker1
k8s-worker2

# Rebuilds reuse the same IPs with fresh host keys, so pinning known_hosts
# would break every destroy/apply cycle. This keeps hand-run ansible-playbook
# behaving exactly like the terraform-driven runs.
[all:vars]
ansible_ssh_common_args=-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
