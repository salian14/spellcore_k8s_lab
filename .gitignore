# Terraform: local state, provider cache, and generated artifacts (the Ansible
# inventory and the lab SSH keypair) -- all machine-local, none of it belongs
# in the repo. The dependency lock file (.terraform.lock.hcl) IS committed.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/inventory.ini
terraform/artifacts/
*.auto.tfvars

# Leftover Vagrant machine state from before the Terraform migration; can be
# deleted (and this entry with it) once the old VMs are destroyed.
.vagrant/
