---
# Copy this file to host_vars/k8s-control.yml (untracked/local) and uncomment
# whatever you want to override. Anything left commented keeps the role's
# default from roles/k8s_argocd/defaults/main.yml.
#
# NOTE: the observability stack is no longer configured here. Its values files,
# credentials and dashboards live under gitops/observability/ and are deployed
# by Argo CD, so changing them is a commit to that directory -- see
# gitops/README.md. The only Ansible-side knobs left are Argo CD's own, below,
# plus which branch of this repository Argo CD deploys from.

# --- Argo CD ---
# Which branch (or tag, or commit) of this repository the cluster runs. The
# default is `bifrost`, the test/dev branch. To try a feature branch on the
# lab cluster, set it here and re-run ansible/k8s-argocd.yml: the bootstrap
# Application is re-applied and every Application under gitops/ follows the
# new revision on Argo CD's next poll.
# k8s_argocd_bootstrap_repo_revision: agent/feat/my-change

# The repository itself and the chart path inside it. Point these elsewhere
# only if you fork the GitOps tree out of this repo. Set the URL to "" to
# install Argo CD with no applications at all.
# k8s_argocd_bootstrap_repo_url: https://github.com/salian14/spellcore_k8s_lab.git
# k8s_argocd_bootstrap_repo_path: gitops/bootstrap

# Automated sync with prune and self-heal on the bootstrap Application. Set
# false to review the first sync by hand in the UI. The component
# Applications under gitops/ carry their own sync policy regardless.
# k8s_argocd_bootstrap_sync_automated: true

# Login is always `admin`; this is its password. Hashed with bcrypt at render
# time (needs passlib + bcrypt on the workstation). Bump the mtime when you
# change it so sessions issued under the old password are invalidated.
# k8s_argocd_admin_password: lab-argocd
# k8s_argocd_admin_password_mtime: "2026-09-15T00:00:00Z"

# NodePort the UI/API is reached at on the host browser. 30080 is taken by
# fathom/fathom-agent, 30300 and 30090 by Grafana and Prometheus (both set in
# gitops/observability/values/).
# k8s_argocd_server_node_port: 30800

# How often every source repository is re-polled. No webhook can reach the lab,
# so this is the only way a push lands. Upstream default is 180s.
# k8s_argocd_reconciliation_timeout: 60s

# Optional components, both off by default -- no SSO provider to federate, and
# nowhere to send notifications from an isolated network.
# k8s_argocd_dex_enabled: false
# k8s_argocd_notifications_enabled: false

# Set to false to skip the role entirely.
# k8s_argocd_enabled: true

# --- storage ---
# Set to false to skip installing local-path-provisioner from
# k8s-cluster-bootstrap.yml. Everything Argo CD deploys that claims a volume
# then sits Pending until some other StorageClass named `local-path` exists.
# k8s_local_path_storage_enabled: true

# NOTE: k8s_node_storage_expand runs on the workers too, so its variables do
# NOT belong in this file -- a host_vars/k8s-control.yml override would apply to
# the control plane alone and silently leave the workers unexpanded. Put those
# in group_vars/all.yml instead:
#
#   k8s_node_storage_expand_enabled: true
#   # +100%FREE claims all remaining volume group space, which forecloses adding
#   # a separate LV later (a dedicated /var/lib/containerd, say). Use "+32G" or
#   # similar to leave room.
#   k8s_node_storage_expand_extents: "+100%FREE"
